// ============================================================
// Budget King BD — Prisma Schema (Milestone 1 MVP)
// ============================================================
// Designed per: product-management.md, Shopping-flow.md,
// Order&delivery.md, Db-design&coin.md, role.md, Security-plan.md
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CUSTOMER
  AGENT
  MODERATOR
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  DELIVERY_FAILED
  RETURN_REQUESTED
  RETURNED
  EXCHANGE_REQUESTED
  EXCHANGED
}

enum PaymentMethod {
  COD
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum HomepageSectionType {
  HERO
  BANNER
  PRODUCT_GRID
  CATEGORY_GRID
  TEXT
  REVIEW_GRID
  GROUP_PROMOTION
  REWARD_PROMOTION
}

enum InventoryMovementType {
  INITIAL
  RESTOCK
  RESERVED
  RELEASED
  SOLD
  RETURNED
  ADJUSTMENT
  DAMAGED
}

enum CoinTransactionType {
  EARNED          // coins earned from a delivered order
  EARNED_REVERSAL // reversal when an order is cancelled/returned after earning
  REDEEMED        // coins spent to convert into a voucher
  REDEEMED_REVERSAL
  EXPIRED         // coins that hit their expiration date
  ADMIN_ADJUSTMENT
  REFERRAL_BONUS  // future
}

enum VoucherType {
  FIXED_AMOUNT // tk X off
  PERCENTAGE   // X% off
}

enum CustomerVoucherStatus {
  ACTIVE    // available to use
  USED      // applied to an order
  EXPIRED   // passed expiry date
  REVOKED   // admin revoked
}

// ============================================================
// USERS & PROFILES
// ============================================================

model Profile {
  id              String    @id // matches auth.users.id from Supabase
  email           String    @unique
  fullName        String?
  phone           String?
  avatarUrl       String?
  role            UserRole  @default(CUSTOMER)
  isStaff         Boolean   @default(false)
  isSuspended     Boolean   @default(false)
  isSupremeAdmin  Boolean   @default(false) // The ONE admin who cannot be changed/suspended/deleted by anyone
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Customer relations
  addresses        Address[]
  orders           Order[]
  reviews          Review[]
  cartItems        CartItem[]
  coinTransactions CoinTransaction[]
  vouchers         CustomerVoucher[]

  // Group relations
  ownedGroups      Group[]          @relation("GroupOwner")
  groupMemberships GroupMember[]
  sharedGroupProducts GroupProduct[]
  groupVotes       GroupVote[]
  groupCartItems   GroupCartItem[]

  // Notifications
  notifications    Notification[]

  // Content & growth
  blogPosts        BlogPost[]
  referralCodes    ReferralCode[]
  referredBy       ReferralEvent[]

  // Staff relations (agent who handles orders)
  assignedOrders   Order[] @relation("AgentOrders")

  @@map("profiles")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String? // e.g. "Home", "Office"
  fullName  String
  phone     String
  division String
  district String
  area      String?
  addressLine String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// ============================================================
// CATALOG — Categories, Products, Variants, Images, Attributes
// ============================================================

model Category {
  id          String     @id @default(cuid())
  parentId   String?
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent   Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  attributes Attribute[]
  sizeGuide SizeGuide?

  @@map("categories")
}

model Product {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String?
  shortDescription String?
  categoryId    String
  brand         String?
  basePrice     Decimal       @db.Decimal(10, 2)
  status        ProductStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  images         ProductImage[]
  attributeValues ProductAttributeValue[]
  reviews        Review[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  homepageSections HomepageSectionProduct[]
  sharedInGroups GroupProduct[]

  @@map("products")
}

model ProductVariant {
  id              String        @id @default(cuid())
  productId       String
  sku             String        @unique
  price           Decimal       @db.Decimal(10, 2)
  compareAtPrice  Decimal?      @db.Decimal(10, 2)
  status          VariantStatus @default(ACTIVE)
  // Variant option values stored as JSONB — flexible (color/size/capacity/etc.)
  options        Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  groupCartItems GroupCartItem[]

  @@map("product_variants")
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  variantId  String?
  imageUrl   String
  altText    String?
  sortOrder  Int     @default(0)
  isPrimary  Boolean @default(false)
  createdAt  DateTime @default(now())

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("product_images")
}

// Dynamic attribute system (e.g. Material, Fit, Sleeve, Pattern)
model Attribute {
  id          String         @id @default(cuid())
  name        String
  type        AttributeType
  categoryId  String?
  isFilterable Boolean       @default(false)
  createdAt   DateTime       @default(now())

  category Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  values   ProductAttributeValue[]

  @@map("attributes")
}

model ProductAttributeValue {
  id          String   @id @default(cuid())
  productId   String
  attributeId String
  value       String
  createdAt   DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute  @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@map("product_attribute_values")
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
  id              String  @id @default(cuid())
  variantId       String  @unique
  quantity        Int     @default(0)
  reserved        Int     @default(0) // locked by pending orders
  updatedAt       DateTime @updatedAt

  variant    ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@map("inventory")
}

model InventoryMovement {
  id         String              @id @default(cuid())
  inventoryId String
  type       InventoryMovementType
  quantity   Int
  note       String?
  refOrderId String?
  createdBy  String?
  createdAt  DateTime            @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@map("inventory_movements")
}

// ============================================================
// CART (Customer logged-in state; guests use local Zustand)
// ============================================================

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  variantId  String
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@map("cart_items")
}

// ============================================================
// DELIVERY ZONES & CHARGES
// ============================================================

model DeliveryZone {
  id           String   @id @default(cuid())
  name         String   @unique // e.g. "Dhaka", "Outside Dhaka"
  divisions    String[] // list of divisions covered
  charge       Decimal  @db.Decimal(10, 2)
  estimatedDays Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
  groups Group[]

  @@map("delivery_zones")
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique // e.g. BK-2026-001024
  userId          String? // null for guests
  agentId         String? // assigned staff
  status          OrderStatus  @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)

  // Customer info snapshot (so order survives profile deletion / guest checkout)
  customerName    String
  customerPhone   String
  customerEmail   String?

  // Delivery snapshot
  deliveryAddressJson Json
  addressId       String?
  deliveryZoneId  String?
  deliveryCharge  Decimal      @db.Decimal(10, 2) @default(0)

  // Pricing snapshot
  subtotal        Decimal      @db.Decimal(10, 2)
  discount        Decimal      @db.Decimal(10, 2) @default(0)
  total           Decimal      @db.Decimal(10, 2)

  // Voucher applied at checkout (Phase 5)
  appliedVoucherId String? @unique

  // Group order (Phase 6) — set when this order is a group checkout
  groupOrderId String?

  // Tracking
  notes           String?
  cancelReason    String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user           Profile?        @relation(fields: [userId], references: [id])
  agent          Profile?        @relation("AgentOrders", fields: [agentId], references: [id])
  address        Address?        @relation(fields: [addressId], references: [id])
  items          OrderItem[]
  deliveryZone   DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id])
  statusHistory  OrderStatusHistory[]
  coinTransactions CoinTransaction[]
  appliedVoucher CustomerVoucher? @relation
  group          Group?          @relation("GroupOrders", fields: [groupOrderId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([agentId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2) // snapshot
  totalPrice  Decimal  @db.Decimal(10, 2) // snapshot

  // Snapshot of product info at time of order
  productName   String
  variantLabel  String
  productImage  String?
  productSku    String

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant  @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id                 String   @id @default(cuid())
  userId             String
  productId          String
  orderId            String
  rating             Int      // 1-5
  title              String?
  content            String?
  status             String   @default("PENDING") // PENDING | APPROVED | REJECTED
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, orderId])
  @@map("reviews")
}

// ============================================================
// HOMEPAGE CMS
// ============================================================

model HomepageSection {
  id          String   @id @default(cuid())
  sectionType HomepageSectionType
  title       String?
  subtitle    String?
  content     String? // JSON blob for flexible content
  imageUrl    String?
  buttonText  String?
  buttonLink  String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productRefs HomepageSectionProduct[]

  @@map("homepage_sections")
}

model HomepageSectionProduct {
  sectionId  String
  productId  String
  sortOrder  Int @default(0)

  section HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([sectionId, productId])
  @@map("homepage_section_products")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // user id who performed the action
  actorRole String?
  action    String // e.g. "order.confirm", "product.update", "inventory.adjust"
  target    String? // e.g. "order:BK-2026-001024"
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ============================================================
// REWARDS — Coins, Rules, Vouchers
// (Phase 5)
// ============================================================

// Admin-configurable coin earning rule.
// Example: minPurchase = 2000, coinsAwarded = 2000
model CoinRule {
  id              String   @id @default(cuid())
  name            String   @unique
  minPurchase     Decimal  @db.Decimal(10, 2) // eligible merchandise subtotal
  coinsAwarded    Int
  isActive        Boolean  @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("coin_rules")
}

// Ledger of every coin movement. NEVER delete a row —
// always insert an opposite-sign transaction to reverse.
model CoinTransaction {
  id              String             @id @default(cuid())
  userId          String
  type            CoinTransactionType
  amount          Int // positive for credits, negative for debits
  balanceAfter    Int // snapshot of balance after this transaction
  orderId         String? // source order (for EARNED / EARNED_REVERSAL)
  customerVoucherId String? @unique // the customer voucher redeemed (for REDEEMED)
  ruleId          String? // which CoinRule triggered this
  note            String?
  expiresAt       DateTime? // for EARNED entries (coins expire after N days)
  createdAt       DateTime           @default(now())

  user     Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?              @relation(fields: [orderId], references: [id])
  voucher  CustomerVoucher?   @relation(fields: [customerVoucherId], references: [id])

  // Idempotency: prevent duplicate EARNED entries for the same order
  @@unique([orderId, type])
  @@index([userId])
  @@index([expiresAt])
  @@map("coin_transactions")
}

// Voucher template (admin-defined). Customers convert coins into a customer_voucher.
model Voucher {
  id              String     @id @default(cuid())
  name            String     @unique // display name, e.g. "tk 20 OFF"
  type            VoucherType
  value           Decimal    @db.Decimal(10, 2) // tk amount OR percentage points
  coinCost        Int // coins required to redeem
  minOrderValue   Decimal    @db.Decimal(10, 2) @default(0)
  validDays       Int        @default(30) // customer voucher expires N days after redemption
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  customerVouchers CustomerVoucher[]

  @@map("vouchers")
}

// A voucher redeemed by a specific customer.
// Each redemption generates a unique code.
model CustomerVoucher {
  id              String              @id @default(cuid())
  userId          String
  voucherId       String
  code            String              @unique // e.g. BKVC-7X29P
  status          CustomerVoucherStatus @default(ACTIVE)
  redeemedAt      DateTime            @default(now()) // when coins were spent
  expiresAt       DateTime
  usedOnOrderId   String? @unique // set when applied to an order
  usedAt          DateTime?
  revokedReason   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user      Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher   Voucher           @relation(fields: [voucherId], references: [id])
  order     Order?            @relation(fields: [usedOnOrderId], references: [id])
  coinTx    CoinTransaction? @relation

  @@index([userId, status])
  @@map("customer_vouchers")
}
// ============================================================
// GROUPS — Group Shopping (Phase 6)
// ============================================================

enum GroupMemberRole {
  OWNER
  MEMBER
}

enum GroupStatus {
  ACTIVE
  SUSPENDED   // admin suspended
  CLOSED      // owner closed it
}

enum GroupVoteType {
  UP
  DOWN
}

// A shopping group created by a customer
model Group {
  id              String       @id @default(cuid())
  name            String
  description     String?
  code            String       @unique // short human-friendly invite code e.g. BK7X29
  ownerId         String
  status          GroupStatus  @default(ACTIVE)
  maxMembers      Int          @default(20)
  deliveryZoneId  String?
  // Snapshot of common delivery address used at group checkout
  deliveryAddressJson Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner          Profile           @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        GroupMember[]
  products       GroupProduct[]
  cartItems      GroupCartItem[]
  deliveryZone   DeliveryZone?    @relation(fields: [deliveryZoneId], references: [id])
  orders         Order[]          @relation("GroupOrders")

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id        String          @id @default(cuid())
  groupId   String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  joinedAt  DateTime        @default(now())

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// A product shared into a group's feed for discussion/voting
model GroupProduct {
  id          String   @id @default(cuid())
  groupId     String
  userId      String // who shared it
  productId   String
  note        String? // optional comment from sharer
  createdAt   DateTime @default(now())

  group    Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  votes    GroupVote[]
  cartItem GroupCartItem?

  @@unique([groupId, productId])
  @@index([groupId])
  @@map("group_products")
}

model GroupVote {
  id              String       @id @default(cuid())
  groupProductId  String
  userId          String
  type            GroupVoteType
  createdAt       DateTime     @default(now())

  groupProduct GroupProduct @relation(fields: [groupProductId], references: [id], onDelete: Cascade)
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupProductId, userId])
  @@map("group_votes")
}

// Items added to the group cart by members. Each item is owned by a member
// (their contribution to the combined order).
model GroupCartItem {
  id              String   @id @default(cuid())
  groupId         String
  groupProductId  String   @unique // 1:1 with GroupProduct
  userId          String   // who added this to the cart
  variantId       String
  quantity        Int      @default(1)
  addedAt         DateTime @default(now())

  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupProduct  GroupProduct @relation(fields: [groupProductId], references: [id], onDelete: Cascade)
  user          Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("group_cart_items")
}

// ============================================================
// NOTIFICATIONS (Phase 8)
// In-app notifications for customers and staff.
// Email notifications are sent separately via the email lib.
// ============================================================

enum NotificationType {
  // Order events
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_DELIVERY_FAILED
  // Return / Exchange
  RETURN_REQUESTED
  RETURN_COMPLETED
  EXCHANGE_REQUESTED
  EXCHANGE_COMPLETED
  // Reward events
  COINS_EARNED
  COINS_REVERSED
  VOUCHER_REDEEMED
  VOUCHER_EXPIRING_SOON
  VOUCHER_EXPIRED
  // Group events
  GROUP_MEMBER_JOINED
  GROUP_PRODUCT_SHARED
  GROUP_VOTE_RECEIVED
  GROUP_CART_UPDATED
  GROUP_ORDER_PLACED
  // Staff alerts
  STAFF_NEW_ORDER
  STAFF_CANCELLATION_REQUEST
  STAFF_RETURN_REQUEST
  STAFF_LOW_STOCK
  // Generic
  SYSTEM_ANNOUNCEMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

model Notification {
  id          String           @id @default(cuid())
  userId      String? // null = broadcast to staff role
  roleTarget  String? // if userId is null, broadcast to this role (e.g. "AGENT", "ADMIN")
  type        NotificationType
  title       String
  message     String
  link        String? // e.g. "/order/BK-2026-001024"
  metadata    Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  channel     NotificationChannel @default(IN_APP)
  emailSentAt DateTime?
  createdAt   DateTime         @default(now())

  user        Profile?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([roleTarget, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// CONTENT & GROWTH (Phase 9)
// ============================================================

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  content       String        // markdown
  coverImage    String?
  categoryId    String?
  tags          String[]      @default([])
  status        BlogPostStatus @default(DRAFT)
  publishedAt   DateTime?
  authorId      String
  viewCount     Int           @default(0)
  metaDescription String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  author     Profile       @relation(fields: [authorId], references: [id])
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("blog_posts")
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())

  posts BlogPost[]

  @@map("blog_categories")
}

// Size guide per category (e.g. shirts size chart)
model SizeGuide {
  id          String   @id @default(cuid())
  categoryId  String   @unique
  title       String
  // JSON array of size rows: [{size:"M", chest:"100cm", length:"70cm", shoulder:"45cm"}, ...]
  rows        Json
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("size_guides")
}

// Referral system
model ReferralCode {
  id          String   @id @default(cuid())
  userId      String
  code        String   @unique // user-friendly code, e.g. RAHIM-BK
  uses        Int      @default(0)
  successful  Int      @default(0) // referrals that resulted in a delivered order
  createdAt   DateTime @default(now())

  user     Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events   ReferralEvent[]

  @@index([userId])
  @@map("referral_codes")
}

model ReferralEvent {
  id              String   @id @default(cuid())
  referrerCodeId  String
  referredUserId  String? // null if guest signup (tracked via cookie)
  referredEmail   String
  status          String   @default("PENDING") // PENDING | SIGNED_UP | FIRST_ORDER | REWARDED
  bonusCoinsAwarded Int   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  referrer   ReferralCode @relation(fields: [referrerCodeId], references: [id], onDelete: Cascade)
  referred   Profile?     @relation(fields: [referredUserId], references: [id])

  @@map("referral_events")
}

// Site-wide promotional banners with scheduling
model Banner {
  id          String   @id @default(cuid())
  title       String
  message     String
  ctaText     String?
  ctaLink     String?
  bgColor     String   @default("#d4a017") // amber gold by default
  textColor   String   @default("#ffffff")
  placement   String   @default("top") // top | below_hero | footer
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("banners")
}
